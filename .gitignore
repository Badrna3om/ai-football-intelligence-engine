*.secrets.local.json

# Untracked runtime dumps and execution results
*.log
*.sqlite
*.db
dump.sql
backup.sql
*.bak
*.tmp
*.swp
*.swo

# JavaScript / TypeScript build artifacts
node_modules/
dist/
build/
coverage/
.cache/
.next/

# Python caches
__pycache__/
*.pyc
.venv/
venv/

# General OS / editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/

